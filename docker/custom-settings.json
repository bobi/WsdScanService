{
  "WsdScanService": {
    "OutputDir": "/app/scans",
    "Sane": {
      "UseSaneBackend": true,
      "Device": "pixma:MF220_{Ip}",
      "Format": "pnm",
      "AdditionalArgs": [
        "--calibrate",
        "Never",
        "--buffer-size=1024"
      ],
      "ImageConverters": {
        "default": {
          "Path": "magick",
          "Args": [
            "{InputPath}",
            "-gamma",
            "2.2",
            "-quality",
            "80",
            "-sampling-factor",
            "4:2:0",
            "-interlace",
            "Plane",
            "-strip",
            "JPG:{OutputPath}"
          ]
        },
        "autocrop": {
          "Path": "sh",
          "Args": [
            "{BaseDir}scripts/autocrop.sh",
            "{InputPath}",
            "JPG:{OutputPath}",
            "-gamma",
            "2.2",
            "-quality",
            "80",
            "-sampling-factor",
            "4:2:0",
            "-interlace",
            "Plane",
            "-strip"
          ]
        }
      }
    },
    "Wsd": {
      "ImageConverters": {
        "autocrop": {
          "Path": "sh",
          "Args": [
            "{BaseDir}scripts/autocrop.sh",
            "JPG:{InputPath}",
            "JPG:{OutputPath}",
            "-quality",
            "80",
            "-sampling-factor",
            "4:2:0",
            "-interlace",
            "Plane",
            "-strip"
          ]
        }
      }
    },
    "ScanProfiles": [
      {
        "DisplayName": "Scan to ... (300dpi)",
        "Resolution": 300
      },
      {
        "DisplayName": "Scan to ... (600dpi)",
        "Resolution": 600
      },
      {
        "DisplayName": "Scan to ... (300dpi, autocrop)",
        "Resolution": 300,
        "ImageConverter": "autocrop"
      },
      {
        "DisplayName": "Scan to ... (600dpi, autocrop)",
        "Resolution": 600,
        "ImageConverter": "autocrop"
      }
    ]
  }
}
