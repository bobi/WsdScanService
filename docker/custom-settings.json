{
  "WsdScanService": {
    "OutputDir": "/app/scans",
    "Sane": {
      "UseSaneBackend": true,
      "Device": "pixma:MF220_{Ip}",
      "ImageConverters": {
        "default": {
          "Path": "magick",
          "Args": [
            "JPG:{InputPath}",
            "-gamma",
            "2.2",
            "-quality",
            "80",
            "-sampling-factor",
            "4:2:0",
            "-interlace",
            "Plane",
            "-strip",
            "JPG:{OutputPath}"
          ]
        },
        "autocrop": {
          "Path": "magick",
          "Args": [
            "JPG:{InputPath}",
            "(",
            "+clone",
            "-colorspace",
            "Gray",
            "-resize",
            "25%",
            "(",
            "+clone",
            "-blur",
            "0x10",
            ")",
            "-compose",
            "MinusDst",
            "-composite",
            "+compose",
            "-threshold",
            "2%",
            "-shave",
            "16x16",
            "-bordercolor",
            "black",
            "-border",
            "16x16",
            "-morphology",
            "Close",
            "Disk:4",
            "-define",
            "connected-components:area-threshold=150",
            "-define",
            "connected-components:mean-color=true",
            "-connected-components",
            "8",
            "-sample",
            "400%",
            "-set",
            "option:cropbox",
            "%@",
            "+delete",
            ")",
            "-crop",
            "%[cropbox]",
            "+repage",
            "-bordercolor",
            "white",
            "-border",
            "40",
            "-gamma",
            "2.2",
            "-quality",
            "80",
            "-sampling-factor",
            "4:2:0",
            "-interlace",
            "Plane",
            "-strip",
            "JPG:{OutputPath}"
          ]
        }
      }
    },
    "ScanProfiles": [
      {
        "DisplayName": "Scan to ... (300dpi)",
        "Resolution": 300
      },
      {
        "DisplayName": "Scan to ... (600dpi)",
        "Resolution": 600
      },
      {
        "DisplayName": "Scan to ... (300dpi, autocrop)",
        "Resolution": 300,
        "ImageConverter": "autocrop"
      },
      {
        "DisplayName": "Scan to ... (600dpi, autocrop)",
        "Resolution": 600,
        "ImageConverter": "autocrop"
      }
    ]
  }
}
