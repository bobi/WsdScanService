{
  "WsdScanService": {
    "OutputDir": "/app/scans",
    "Sane": {
      "UseSaneBackend": true,
      "Device": "pixma:MF220_{Ip}",
      "Format": "pnm",
      "AdditionalArgs": ["--calibrate=Never", "--buffer-size=1024"],
      "ImageConverters": {
        "default": {
          "Path": "magick",
          "Args": [
            "{InputPath}",
            "-gamma",
            "2.2",
            "-quality",
            "80",
            "-sampling-factor",
            "4:2:0",
            "-interlace",
            "Plane",
            "-strip",
            "JPG:{OutputPath}"
          ]
        },
        "autocrop": {
          "Path": "magick",
          "Args": [
            "{InputPath}",
            "(",
            "+clone",
            "-colorspace",
            "Gray",
            "-resize",
            "25%",
            "(",
            "+clone",
            "-blur",
            "0x10",
            ")",
            "-compose",
            "MinusDst",
            "-composite",
            "+compose",
            "-threshold",
            "2%",
            "-shave",
            "16x16",
            "-bordercolor",
            "black",
            "-border",
            "16x16",
            "-morphology",
            "Close",
            "Disk:4",
            "-define",
            "connected-components:area-threshold=150",
            "-define",
            "connected-components:mean-color=true",
            "-connected-components",
            "8",
            "-sample",
            "400%",
            "-trim",
            "-set",
            "option:cropbox",
            "%[fx:(page.x+w>page.width*0.95?page.width:page.x+w)-(page.x<page.width*0.05?0:page.x)]x%[fx:(page.y+h>page.height*0.95?page.height:page.y+h)-(page.y<page.height*0.05?0:page.y)]+%[fx:page.x<page.width*0.05?0:page.x]+%[fx:page.y<page.height*0.05?0:page.y]",
            "-set",
            "option:padtl",
            "%[fx:page.x<page.width*0.05?0:round(((page.x+w>page.width*0.95?page.width:page.x+w)-(page.x<page.width*0.05?0:page.x))*0.01)]x%[fx:page.y<page.height*0.05?0:round(((page.y+h>page.height*0.95?page.height:page.y+h)-(page.y<page.height*0.05?0:page.y))*0.01)]",
            "-set",
            "option:padbr",
            "%[fx:page.x+w>page.width*0.95?0:round(((page.x+w>page.width*0.95?page.width:page.x+w)-(page.x<page.width*0.05?0:page.x))*0.01)]x%[fx:page.y+h>page.height*0.95?0:round(((page.y+h>page.height*0.95?page.height:page.y+h)-(page.y<page.height*0.05?0:page.y))*0.01)]",
            "+delete",
            ")",
            "-crop",
            "%[cropbox]",
            "+repage",
            "-background",
            "white",
            "-gravity",
            "NorthWest",
            "-splice",
            "%[padtl]",
            "-gravity",
            "SouthEast",
            "-splice",
            "%[padbr]",
            "+gravity",
            "-gamma",
            "2.2",
            "-quality",
            "80",
            "-sampling-factor",
            "4:2:0",
            "-interlace",
            "Plane",
            "-strip",
            "JPG:{OutputPath}"
          ]
        }
      }
    },
    "Wsd": {
      "ImageConverters": {
        "autocrop": {
          "Path": "magick",
          "Args": [
            "JPG:{InputPath}",
            "(",
            "+clone",
            "-colorspace",
            "Gray",
            "-resize",
            "25%",
            "(",
            "+clone",
            "-blur",
            "0x10",
            ")",
            "-compose",
            "MinusDst",
            "-composite",
            "+compose",
            "-threshold",
            "2%",
            "-shave",
            "16x16",
            "-bordercolor",
            "black",
            "-border",
            "16x16",
            "-morphology",
            "Close",
            "Disk:4",
            "-define",
            "connected-components:area-threshold=150",
            "-define",
            "connected-components:mean-color=true",
            "-connected-components",
            "8",
            "-sample",
            "400%",
            "-trim",
            "-set",
            "option:cropbox",
            "%[fx:(page.x+w>page.width*0.95?page.width:page.x+w)-(page.x<page.width*0.05?0:page.x)]x%[fx:(page.y+h>page.height*0.95?page.height:page.y+h)-(page.y<page.height*0.05?0:page.y)]+%[fx:page.x<page.width*0.05?0:page.x]+%[fx:page.y<page.height*0.05?0:page.y]",
            "-set",
            "option:padtl",
            "%[fx:page.x<page.width*0.05?0:round(((page.x+w>page.width*0.95?page.width:page.x+w)-(page.x<page.width*0.05?0:page.x))*0.01)]x%[fx:page.y<page.height*0.05?0:round(((page.y+h>page.height*0.95?page.height:page.y+h)-(page.y<page.height*0.05?0:page.y))*0.01)]",
            "-set",
            "option:padbr",
            "%[fx:page.x+w>page.width*0.95?0:round(((page.x+w>page.width*0.95?page.width:page.x+w)-(page.x<page.width*0.05?0:page.x))*0.01)]x%[fx:page.y+h>page.height*0.95?0:round(((page.y+h>page.height*0.95?page.height:page.y+h)-(page.y<page.height*0.05?0:page.y))*0.01)]",
            "+delete",
            ")",
            "-crop",
            "%[cropbox]",
            "+repage",
            "-background",
            "white",
            "-gravity",
            "NorthWest",
            "-splice",
            "%[padtl]",
            "-gravity",
            "SouthEast",
            "-splice",
            "%[padbr]",
            "+gravity",
            "-quality",
            "80",
            "-sampling-factor",
            "4:2:0",
            "-interlace",
            "Plane",
            "-strip",
            "JPG:{OutputPath}"
          ]
        }
      }
    },
    "ScanProfiles": [
      {
        "DisplayName": "Scan to ... (300dpi)",
        "Resolution": 300
      },
      {
        "DisplayName": "Scan to ... (600dpi)",
        "Resolution": 600
      },
      {
        "DisplayName": "Scan to ... (300dpi, autocrop)",
        "Resolution": 300,
        "ImageConverter": "autocrop"
      },
      {
        "DisplayName": "Scan to ... (600dpi, autocrop)",
        "Resolution": 600,
        "ImageConverter": "autocrop"
      }
    ]
  }
}
